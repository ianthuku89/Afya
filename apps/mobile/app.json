{
  "expo": {
    "name": "AfyaToken Mobile",
    "slug": "afyaToken-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.seaboard.healthtoken",
      "buildNumber": "1",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Allow AfyaToken to securely lock your wallet.",
        "NSLocationWhenInUseUsageDescription": "AfyaToken requires your location to map nearby SHA-accredited facilities.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.seaboard.healthtoken",
      "versionCode": 1
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow AfyaToken to use your location for finding hospitals."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow AfyaToken to securely lock your wallet."
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiUrl": "https://afya-cvq5.onrender.com/api/v1",
      "eas": {
        "projectId": "3fe08865-1867-475c-9be7-21ac549e848a"
      }
    },
    "owner": "thuku0249s-team",
    "updates": {
      "url": "https://u.expo.dev/3fe08865-1867-475c-9be7-21ac549e848a"
    }
  }
}
