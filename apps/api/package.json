{
    "name": "@afyaToken/api",
    "version": "1.0.0",
    "private": true,
    "description": "AfyaToken Platform Backend API — Node.js + Express + PostgreSQL + Redis",
    "type": "module",
    "main": "dist/server.js",
    "exports": {
        ".": {
            "import": "./dist/server.js",
            "require": "./dist/server.js",
            "types": "./dist/server.d.ts"
        }
    },
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "prisma generate && tsc",
        "vercel-build": "prisma generate && tsc",
        "start": "node dist/server.js",
        "lint": "eslint src --ext .ts",
        "test": "jest --coverage",
        "db:migrate": "prisma migrate dev",
        "db:seed": "tsx src/seed.ts",
        "db:generate": "prisma generate",
        "type-check": "tsc --noEmit"
    },
    "dependencies": {
        "@afyaToken/types": "*",
        "@prisma/client": "^5.13.0",
        "bcryptjs": "^2.4.3",
        "compression": "^1.7.4",
        "cors": "^2.8.5",
        "ethers": "^6.16.0",
        "express": "^4.19.2",
        "express-rate-limit": "^7.3.0",
        "helmet": "^7.1.0",
        "ioredis": "^5.3.2",
        "jose": "^5.2.4",
        "node-fetch": "^3.3.2",
        "uuid": "^9.0.1",
        "winston": "^3.13.0",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/compression": "^1.7.5",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jest": "^30.0.0",
        "@types/node": "^20.12.0",
        "@types/supertest": "^7.2.0",
        "@types/uuid": "^9.0.8",
        "@typescript-eslint/eslint-plugin": "^7.0.0",
        "@typescript-eslint/parser": "^7.0.0",
        "eslint": "^8.57.0",
        "jest": "^30.3.0",
        "prisma": "^5.13.0",
        "supertest": "^7.2.2",
        "ts-jest": "^29.4.6",
        "tsx": "^4.7.2",
        "typescript": "^5.4.0"
    },
    "engines": {
        "node": ">=20.0.0",
        "npm": ">=10.0.0"
    }
}