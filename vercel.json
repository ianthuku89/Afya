{
  "version": 2,
  "installCommand": "npm install",
  "env": {
    "NODE_ENV": "production",
    "CORPORATE_STANBIC_ACCOUNT": ""
  },
  "builds": [
    {
      "src": "apps/web/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "apps/internal/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "apps/seaboard/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "apps/api/dist/server.js",
      "use": "@vercel/node",
      "config": {
        "maxLambdaSize": "15mb"
      }
    }
  ],
  "routes": [
    {
      "src": "^/api/.*",
      "dest": "apps/api/dist/server.js"
    },
    {
      "src": "/admin/(.*)",
      "dest": "apps/web/$1"
    },
    {
      "src": "/internal/(.*)",
      "dest": "apps/internal/$1"
    },
    {
      "src": "/seaboard/(.*)",
      "dest": "apps/seaboard/$1"
    },
    {
      "src": "/(.*)",
      "dest": "apps/web/$1"
    }
  ],
  "regions": [
    "fra1"
  ],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "develop": true
    }
  }
}