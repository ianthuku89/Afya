{
  "version": 2,
  "buildCommand": "npm run vercel-build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "env": {
    "NODE_ENV": "production",
    "CORPORATE_STANBIC_ACCOUNT": ""
  },
  "builds": [
    {
      "src": "apps/web",
      "use": "@vercel/next"
    },
    {
      "src": "apps/internal",
      "use": "@vercel/next"
    },
    {
      "src": "apps/seaboard",
      "use": "@vercel/next"
    },
    {
      "src": "apps/api/dist/server.js",
      "use": "@vercel/node",
      "config": {
        "maxLambdaSize": "15mb"
      }
    }
  ],
  "routes": [
    {
      "src": "^/api/.*",
      "dest": "apps/api/dist/server.js"
    },
    {
      "src": "/admin/(.*)",
      "dest": "apps/web"
    },
    {
      "src": "/internal/(.*)",
      "dest": "apps/internal"
    },
    {
      "src": "/seaboard/(.*)",
      "dest": "apps/seaboard"
    },
    {
      "src": "/(.*)",
      "dest": "apps/web"
    }
  ],
  "regions": [
    "fra1"
  ],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "develop": true
    }
  }
}