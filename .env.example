# AfyaToken Platform — Environment Variables Template
# Copy this file to .env in each app directory and fill in real values.
# NEVER commit .env files to git.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://afyaToken:afyaToken_dev_password@localhost:5432/afyaToken_db
POSTGRES_USER=afyaToken
POSTGRES_PASSWORD=afyaToken_dev_password
POSTGRES_DB=afyaToken_db

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:redis_dev_pass@localhost:6379
REDIS_PASSWORD=redis_dev_pass

# ── JWT RS256 (generate: openssl genrsa -out private.pem 4096) ────────────────
# DER format with \n escaped as \\n for environment variable storage
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<your-private-key>\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n<your-public-key>\n-----END PUBLIC KEY-----"

# ── Encryption ────────────────────────────────────────────────────────────────
# 32+ character random secret — stored in AWS Secrets Manager in production
ENCRYPTION_KEY=change-this-to-a-very-long-random-secret-at-least-32-chars
ENCRYPTION_SALT=afyaToken-salt-v1

# ── API Config ────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:3000

# ── ML Service ────────────────────────────────────────────────────────────────
ML_SERVICE_URL=http://localhost:8001
ML_SERVICE_KEY=dev-internal-key

# ── Hyperledger Besu ──────────────────────────────────────────────────────────
BESU_RPC_URL=http://localhost:8545
BESU_WS_URL=ws://localhost:8546

# ── AfyaToken Smart Contracts ───────────────────────────────────────────────────────
AfyaToken_TOKEN_ADDRESS=
HEALTH_PAYMENT_ADDRESS=
CLAIM_REGISTRY_ADDRESS=
TREASURY_RESERVE_ADDRESS=
